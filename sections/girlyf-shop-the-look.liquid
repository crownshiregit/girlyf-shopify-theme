{%- comment -%}
  GIRLYF — SHOP THE LOOK

  The reels strip. `scripts/build-homepage.mjs` has listed this as "needs a
  Girlyf-authored section reading custom.reels" since the homepage was first
  generated; this is that section.

  A reel is a styled 9:16 marketing clip, usually repurposed from Instagram, and
  it lives in the `custom.reels` metafield rather than the product's media
  gallery precisely so it can be rendered HERE and not between two packshots.
  See docs/decisions/three-kinds-of-product-video.md.

  Every card is a link to the product it is a reel of, which is the entire point
  of the strip: Instagram's own reels are shoppable nowhere.

  A product may hold several reels. `reels_per_product` defaults to 1 so that
  one enthusiastic product cannot fill the whole rail.

  If no product in the collection has a reel the section renders nothing at all
  on the storefront — and an explanation in the theme editor, where "nothing at
  all" is indistinguishable from a broken section.
{%- endcomment -%}

{% liquid
  assign section_id = section.id
  assign per_product = section.settings.reels_per_product
  assign max_reels = section.settings.max_reels
  assign shown = 0
%}

{%- capture cards -%}
  {%- for product in section.settings.collection.products limit: 40 -%}
    {%- if shown >= max_reels -%}{%- break -%}{%- endif -%}

    {%- for reel in product.metafields.custom.reels.value limit: per_product -%}
      {%- if shown >= max_reels -%}{%- break -%}{%- endif -%}
      {%- if reel.sources.size == 0 -%}{%- continue -%}{%- endif -%}

      {%- liquid
        assign step = shown
        if step > 5
          assign step = 5
        endif
        assign poster = reel.preview_image | default: product.featured_image
      -%}

      <li
        class="girlyf-reels__item"
        data-girlyf-reveal
        style="--girlyf-reveal-delay: {{ step | times: 80 }}ms;"
      >
        <a class="girlyf-reels__link" href="{{ product.url }}">
          <span class="girlyf-reels__frame girlyf-card-edge">
            <video
              class="girlyf-reels__media"
              data-girlyf-autoplay
              {% if poster != blank %}poster="{{ poster | image_url: width: 720 }}"{% endif %}
              muted
              loop
              playsinline
              preload="none"
              tabindex="-1"
              aria-hidden="true"
            >
              {%- comment -%}
                mp4 only — Shopify also publishes an m3u8, which Chrome will
                select and then fail to play natively.
              {%- endcomment -%}
              {%- for source in reel.sources -%}
                {%- if source.format == 'mp4' -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endif -%}
              {%- endfor -%}
            </video>
            <span class="girlyf-reels__scrim" aria-hidden="true"></span>
          </span>

          <span class="girlyf-reels__meta">
            <span class="girlyf-reels__title">{{ product.title }}</span>
            {%- comment -%}
              The guidelines name gold for prices. It measures 2.33:1 on Paper,
              so the price is set in Espresso and gold marks the card instead —
              gold is a fill and a mark, never an ink. See
              docs/decisions/six-brand-roles-onto-four-horizon-slots.md.
            {%- endcomment -%}
            <span class="girlyf-reels__price">{{ product.price | money }}</span>
          </span>
        </a>
      </li>

      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{% if cards == blank %}
  {% if request.design_mode %}
    <div class="section section--page-width spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
      <p class="girlyf-body">
        No reels yet, so this section is hidden on the storefront. Add one in the
        Shopify admin: open a product in
        <strong>{{ section.settings.collection.title | default: 'the chosen collection' }}</strong>
        and use the pinned <strong>Reels</strong> field. Trust video — the item
        worn or turning — goes in the product's media gallery instead.
      </p>
    </div>
  {% endif %}
{% else %}
  {% liquid
    if section.settings.background_color != blank
      render 'contrast-override', background_color: section.settings.background_color, section_id: section_id
    endif
  %}

  <div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"></div>

  <div
    class="section section--page-width spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="girlyf-reels">
      <header class="girlyf-reels__header" data-girlyf-reveal>
        <div class="girlyf-reels__headings">
          {% if section.settings.eyebrow != blank %}
            <p class="girlyf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="girlyf-heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          <span class="girlyf-rule" aria-hidden="true"></span>
        </div>

        {% if section.settings.description != blank %}
          <p class="girlyf-body girlyf-reels__description">{{ section.settings.description | escape }}</p>
        {% endif %}
      </header>

      <ul class="girlyf-rail girlyf-reels__list" data-girlyf-rail role="list">
        {{ cards }}
      </ul>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .girlyf-reels {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .girlyf-reels__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .girlyf-reels__headings {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  @media screen and (min-width: 750px) {
    .girlyf-reels__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--gap-3xl);
    }

    .girlyf-reels__description {
      text-align: right;
      max-inline-size: 34ch;
    }
  }

  .girlyf-reels__list {
    --girlyf-rail-gap: var(--gap-lg);

    list-style: none;
    margin-block: 0;
    padding-block: 0 var(--gap-xs);
  }

  .girlyf-reels__item {
    inline-size: 66vw;
  }

  @media screen and (min-width: 750px) {
    .girlyf-reels__item {
      /* Four and a bit across a page-width rail: the fifth card is visibly cut,
         which is the only dependable hint that a rail scrolls. */
      inline-size: min(22vw, 19rem);
    }
  }

  .girlyf-reels__link {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    text-decoration: none;
    color: inherit;
  }

  .girlyf-reels__frame {
    position: relative;
    display: block;
    overflow: hidden;
    /* The delivery spec for a reel is 9:16. Anything else is letterboxed rather
       than cropped, because a marketing clip has composed edges. */
    aspect-ratio: 9 / 16;
    border-radius: var(--card-corner-radius, 4px);
    background-color: var(--girlyf-cream);
  }

  .girlyf-reels__media {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Espresso, barely there, only at the foot — it stops a bright clip ending
     flush against Paper, and it carries no text so it needs no contrast. */
  .girlyf-reels__scrim {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 35%;
    background: linear-gradient(to top, rgb(var(--color-foreground-rgb) / 0.18), transparent);
    pointer-events: none;
  }

  .girlyf-reels__meta {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }

  .girlyf-reels__title {
    font-family: var(--font-body--family);
    font-size: var(--font-size--paragraph);
    line-height: 1.4;
    color: var(--color-foreground);
  }

  .girlyf-reels__price {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--h4);
    color: var(--color-foreground);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .girlyf-reels__media {
      transition: transform var(--girlyf-hover-duration-slow, 900ms) var(--girlyf-ease, ease);
    }

    .girlyf-reels__link:hover .girlyf-reels__media,
    .girlyf-reels__link:focus-visible .girlyf-reels__media {
      transform: scale(1.04);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Girlyf shop the look",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Plays the Reels metafield from the products in the chosen collection. Hidden on the storefront until at least one product has a reel."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In motion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Every piece, worn and turning — the way it looks off the page."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "reels_per_product",
      "label": "Reels per product",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "max_reels",
      "label": "Most reels to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 10
    },
    { "type": "color", "id": "background_color", "label": "Background", "placeholder": "Default" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [{ "name": "Girlyf shop the look", "category": "Girlyf" }]
}
{% endschema %}
